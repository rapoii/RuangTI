# Better Auth Configuration
BETTER_AUTH_SECRET=generate_strong_random_secret_with_openssl_or_python
BETTER_AUTH_URL=https://ruangti.varevastudio.tech

# Google OAuth (RuangTI Go + Svelte)
# Dapatkan dari Google Cloud Console: APIs & Services -> Credentials -> OAuth client ID
# WAJIB daftarkan Authorized redirect URI persis: {APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL publik aplikasi (dipakai membangun redirect URI OAuth).
# Lokal: http://localhost:8000 | Publik: https://ruangti.varevastudio.tech
APP_BASE_URL=http://localhost:8000

# Umur sesi login (detik). Opsional, default 30 hari.
# SESSION_TTL_SECONDS=2592000

# Microsoft 365 Entra ID OAuth (@student.untirta.ac.id)
# Dapatkan dari Microsoft Entra ID (Azure Portal) -> App registrations
# Authorized redirect URI: http://localhost:3005/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Backend API
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
