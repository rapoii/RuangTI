# ==========================================
# RuangTI Environment Variables Configuration
# ==========================================

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3005"
BETTER_AUTH_URL="http://localhost:3005"

# Better Auth Secret (Random string min 32 chars)
BETTER_AUTH_SECRET="ruangti_better_auth_secret_key_untirta_2026_industrial_engineering"

# ------------------------------------------
# 1. GOOGLE OAUTH PROVIDER (@untirta.ac.id)
# ------------------------------------------
# Dapatkan Client ID & Secret dari Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:3005/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------
# 2. MICROSOFT 365 OAUTH (@student.untirta.ac.id)
# ------------------------------------------
# Dapatkan Client ID & Secret dari Microsoft Entra ID (Azure Portal):
# https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Authorized Redirect URI: http://localhost:3005/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# ------------------------------------------
# 3. AI & Backend Configuration
# ------------------------------------------
NEXT_PUBLIC_API_BASE="http://127.0.0.1:8000"
AI_GATEWAY_URL="http://localhost:20128/v1"
AI_MODEL_NAME="gcli/grok-4.6-high"
